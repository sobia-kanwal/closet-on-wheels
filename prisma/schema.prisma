datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String? // bcrypt-hashed, nullable for social login
  image      String? // profile picture
  role       Role     @default(USER)
  provider   String? // google, facebook, credentials
  providerId String? // external provider id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  products   Product[] // items user lends
  rentals    Rental[] // items user rents
  reviews    Review[] // user reviews
  activities UserActivity[]
}

enum Role {
  USER
  ADMIN
}

model Product {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  brand       String?
  category    String?
  size        String?
  color       String?
  price       Float
  rentalPrice Float?
  images      String[]
  status      ProductStatus @default(PENDING)
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  ownerId    Int
  owner      User           @relation(fields: [ownerId], references: [id])
  rentals    Rental[]
  reviews    Review[]
  activities UserActivity[] // <-- Add this line
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  RENTED
}

model Rental {
  id         Int          @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     RentalStatus @default(RESERVED)
  createdAt  DateTime     @default(now())

  // Relations
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  renterId  Int
  renter    User    @relation(fields: [renterId], references: [id])
}

enum RentalStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1–5 stars
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
}

model UserActivity {
  id        Int          @id @default(autoincrement())
  type      ActivityType
  createdAt DateTime     @default(now())

  // Relations
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

enum ActivityType {
  VIEW
  LIKE
  RENT
  FAVORITE
}
